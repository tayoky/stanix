ENV_PATH=/bin:/usr/bin
CREATE_HOME=yes
DEFAULT_HOME=yes
FAIL_DELAY=3
GID_MIN=1000
GID_MAX=60000
HOME_MODE=0700
LOG_OK_LOGINS=yes
LOGIN_RETRIES=3
LOGIN_TIMEOUT=60
SYS_GID_MIN=101
SYS_GID_MAX=999
SYS_UID_MIN=101
SYS_UID_MAX=999
TTYGROUP=tty
TTYPERM=0620
UID_MIN=1000
UID_MAX=60000
UMASK=022
USERGROUPS_ENAB=yes
